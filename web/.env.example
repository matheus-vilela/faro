# Troque de ambiente: yarn env dev | yarn env prod (reinicie `yarn dev` depois).

# --- DEV ---
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key
VITE_FARO_ENV=dev

# --- PRODUÇÃO ---
# VITE_SUPABASE_URL=https://your-prod-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-prod-anon-key
# VITE_FARO_ENV=production

# Opcional: sobrescreve o número padrão exibido em Configurações → WhatsApp (padrão: +55 11 917589292)
# VITE_FARO_WHATSAPP_AGENT_DISPLAY="+55 11 917589292"
